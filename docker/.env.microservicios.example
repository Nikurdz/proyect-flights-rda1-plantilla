# Variables del demo docker-compose.microservicios.yml. Copie a docker/.env.microservicios (gitignored):
#   cp docker/.env.microservicios.example docker/.env.microservicios
# Todos los valores son de DEMO: nunca ponga aqui secretos reales ni los de produccion.

POSTGRES_DB=vuelos_demo
POSTGRES_USER=vuelos
POSTGRES_PASSWORD=demo-postgres-pass
RABBITMQ_USER=vuelos
RABBITMQ_PASS=demo-rabbit-pass

# Mismos valores en el nucleo y en los satelites (los tokens se firman y las columnas se cifran con ellos).
JWT_SECRET=demo-microservicios-jwt-secret-0123456789abcdef
# 32 bytes en base64 (demo). Generar otra: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=ZGVtby1taWNyb3NlcnZpY2lvcy1jbGF2ZS0zMmJ5ISE=

# Cuenta administradora que crea el seed (la usa npm run micro:smoke).
ADMIN_EMAIL=admin-demo@example.com
ADMIN_PASSWORD=DemoAdmin-12345

# Cliente OAuth2 de socio que crea el seed (>= 24 caracteres el secreto).
PARTNER_CLIENT_ID=booking-prototipo
PARTNER_CLIENT_SECRET=demo-partner-secret-0123456789abcd

# Origen del navegador permitido por CORS en el nucleo, y URL publica de la web (enlaces de los correos).
CORS_ORIGINS=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:8080

# Se incrusta al compilar el frontend (npm run micro:build); debe terminar en /api/v1.
VITE_API_URL=http://localhost:8000/api/v1
