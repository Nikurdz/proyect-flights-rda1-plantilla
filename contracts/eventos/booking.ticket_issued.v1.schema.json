{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ram-alliance.example/eventos/booking.ticket_issued/1",
  "title": "booking.ticket_issued",
  "description": "Billetes emitidos.",
  "x-event-type": "booking.ticket_issued",
  "x-schema-version": "1.1.0",
  "type": "object",
  "required": [
    "bookingId",
    "pnr",
    "holdId",
    "ownerId",
    "status"
  ],
  "properties": {
    "bookingId": {
      "type": "string"
    },
    "pnr": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "holdId": {
      "type": "string"
    },
    "ticketNumbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grandTotal": {
      "type": "object",
      "required": [
        "currency",
        "total"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "total": {
          "type": "string"
        }
      }
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string"
          },
          "eTicketNumber": {
            "type": "string"
          },
          "passengerId": {
            "type": "string"
          }
        }
      }
    },
    "paymentReference": {
      "type": "string"
    }
  }
}
