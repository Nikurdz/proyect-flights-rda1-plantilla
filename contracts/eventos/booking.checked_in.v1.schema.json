{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ram-alliance.example/eventos/booking.checked_in/1",
  "title": "booking.checked_in",
  "description": "Check-in realizado para uno o más pasajeros.",
  "x-event-type": "booking.checked_in",
  "x-schema-version": "1.1.0",
  "type": "object",
  "required": [
    "bookingId",
    "ownerId",
    "checkedInPassengers"
  ],
  "properties": {
    "bookingId": {
      "type": "string"
    },
    "pnr": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "checkedInPassengers": {
      "type": "number"
    },
    "partnerOrderId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Id de la orden del socio (salesChannel.partnerOrderId), si la reserva vino de un socio."
    }
  }
}
