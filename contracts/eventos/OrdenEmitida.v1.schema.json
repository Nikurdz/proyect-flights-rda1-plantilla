{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ram-alliance.example/eventos/OrdenEmitida/1",
  "title": "OrdenEmitida",
  "description": "Orden pagada y emitida: dispara la notificación de confirmación.",
  "x-event-type": "OrdenEmitida",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "ordenId",
    "numeroOrden",
    "correo"
  ],
  "properties": {
    "ordenId": {
      "type": "string"
    },
    "numeroOrden": {
      "type": "string"
    },
    "pnr": {
      "type": [
        "string",
        "null"
      ]
    },
    "clienteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownerId": {
      "type": "string"
    },
    "correo": {
      "type": "string"
    },
    "idioma": {
      "type": "string"
    },
    "total": {
      "type": "string"
    },
    "itinerarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "numeroVuelo",
          "origen",
          "destino"
        ],
        "properties": {
          "numeroVuelo": {
            "type": "string"
          },
          "origen": {
            "type": "string"
          },
          "destino": {
            "type": "string"
          },
          "salida": {
            "type": "string"
          },
          "llegada": {
            "type": "string"
          },
          "familia": {
            "type": "string"
          }
        }
      }
    },
    "pasajeros": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nombres",
          "apellidos"
        ],
        "properties": {
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "eTicket": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
