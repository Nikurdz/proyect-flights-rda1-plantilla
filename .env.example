DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
# Hosted Postgres that requires TLS (Neon, Supabase): set PGSSLMODE=require (TypeORM ignores ?sslmode= in the URL)
# PGSSLMODE=require
NODE_ENV=development
PORT=3000

# Vuelos module (see src/modules/vuelos/README.md)
TAX_RATE=0.15
DEFAULT_CURRENCY=USD
OFFER_TTL_MINUTES=15
HOLD_TTL_MINUTES=15
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_TTL_SECONDS=3600
OFFER_MAX_COMBINATIONS=5
MAX_PASSENGERS_PER_ORDER=9

# Optional: enables `npm test` integration suites (needs a dedicated, disposable database)
# Background jobs / abuse limits (optional). Longer intervals let a serverless Postgres suspend between requests.
# HOLDS_SWEEP_INTERVAL_MS=300000
# RECONCILIATION_INTERVAL_MS=300000
# WEBHOOK_POLL_INTERVAL_MS=60000
# GLOBAL_RATE_LIMIT_MAX=300           # requests per client per window; 0 disables
# GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_test"

# Encrypts passenger/contact/billing data at rest (32 bytes, base64: `openssl rand -base64 32`).
# Optional in development (derived from JWT_SECRET); REQUIRED in production.
# DATA_ENCRYPTION_KEY=

# Optional: seeds the first back-office administrator (both or neither; password >= 12 chars).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-admin-password

# Base URL of the web front end (e-mail verification links).
# PUBLIC_WEB_URL=http://localhost:3000

# Number of reverse-proxy hops to trust for req.ip (set to 1 behind Render/most PaaS; leave unset locally).
# TRUST_PROXY=1

# Front-end origins allowed to call the API from a browser (comma-separated, no trailing slash).
# Required in production for a web front end; outside production any localhost port is allowed.
# CORS_ORIGINS=https://mi-front.vercel.app

# After-sale rules (defaults shown; USD amounts, hours, minutes). The contract does not fix them: they are team decisions.
# POSTSALE_BAGGAGE_PRICE_USD=40
# POSTSALE_BAGGAGE_MAX_PER_LEG=2
# POSTSALE_CUTOFF_HOURS=3
# POSTSALE_CHANGE_FEE_USD=30
# POSTSALE_CANCEL_PENALTY_PERCENT=10
# POSTSALE_QUOTE_TTL_MINUTES=15
# CHECKIN_OPENS_HOURS=48
# CHECKIN_CLOSES_HOURS=1
# BOARDING_WINDOW_MINUTES=30

# Webhooks: max subscriptions per account. Allowing private hosts is ONLY for local tests (the app refuses to boot with it in production).
# WEBHOOKS_MAX_PER_OWNER=10
# WEBHOOKS_ALLOW_PRIVATE_HOSTS=false

# Partner services (Gestión de Proveedores). Private hosts and plain http are ONLY for the course network and local tests: the app refuses to boot with it in production (SSRF).
# PROVEEDORES_ALLOW_PRIVATE_HOSTS=false
# PROVEEDORES_TIMEOUT_MS=8000
# PROVEEDORES_MAX_RESPONSE_BYTES=2000000
# PROVEEDORES_SYNC_MAX_ITEMS=500
# PROVEEDORES_BREAKER_RESET_MS=30000
# PROVEEDORES_HEALTH_INTERVAL_MS=60000

# Free serverless Postgres (Neon) bills compute while awake and sleeps after 5 min without queries. Background jobs only run while the system is in use:
# with no request or event for APP_IDLE_MS (default 10 min, minimum 1 min) they skip their ticks so the database can sleep. Point health checks and monitors at
# /api/v1/health/live (it never touches the database). Pool size and TLS for managed Postgres (Aiven free allows 20 connections):
# APP_IDLE_MS=600000
# DB_POOL_MAX=5
# DB_SSL_CA=-----BEGIN CERTIFICATE-----...   (the provider CA, PEM; used by the app, the migrations and the seed: encrypted AND verified. Aiven: Service > CA certificate)

# Message broker (optional). Empty = events stay in process. With a URL the events travel through RabbitMQ (exchange booking.events, queues q.ordenes.confirmadas / q.sagas.compensacion / q.general, 3 retries, then q.dead_letter).
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# GraphQL gateway (/graphql): deepest query accepted; introspection is off when NODE_ENV=production.
# GRAPHQL_MAX_DEPTH=7

# Technical logs: files logs/combined.log, error.log and audit.log (JSON lines with the correlation id).
# LOG_DIR=logs
# LOG_TO_FILES=true

# Request log table (peticiones_http): rows older than this are purged.
# HTTP_LOG_RETENTION_DAYS=7

# Leaves a few flights sold out / nearly full on purpose for the demo (default: on). See seed/flights.seed.ts.
# SEED_DEMO_SCENARIOS=false
