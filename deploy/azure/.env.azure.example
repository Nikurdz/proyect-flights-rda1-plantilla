# Copia este archivo a `.env.azure` (esta ignorado por git) y copia los valores desde las variables de Railway.
# Los valores sensibles se guardan como secretos de la Container App.

# --- obligatorias ---
DATABASE_URL=
# Certificado de la CA de Aiven (PEM). Puede ir en una linea con "\n" literales, como en Railway.
DB_SSL_CA=
JWT_SECRET=
# EXACTAMENTE la misma que en Railway: si cambia, los datos personales ya cifrados no se pueden leer.
DATA_ENCRYPTION_KEY=

# --- identidad del nodo y Booking ---
NODE_ID=NODE_VUE_RAM_ALLIANCE
PARTNER_CLIENT_ID=booking-prototipo
PARTNER_CLIENT_SECRET=
BOOKING_STOCK_URL=https://booking-core-api.azurewebsites.net/api/v2/inventory/stock
# BOOKING_WEBHOOK_URL=
# BOOKING_WEBHOOK_SECRET=
# BOOKING_STOCK_API_KEY=
# BOOKING_PAGOS_API_KEY=

# --- frontend y administrador ---
# Origen del frontend de Netlify (sin barra final) y su URL base para los enlaces de correo.
CORS_ORIGINS=
PUBLIC_WEB_URL=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- ajustes ---
# Aiven free permite 20 conexiones.
DB_POOL_MAX=5
# TAX_RATE=0.15
# STOCK_PUSH_HORIZON_DAYS=14
# STOCK_PUSH_FULL_RESYNC_MINUTES=60
# (NODE_ENV, PORT, TRUST_PROXY=1 y LOG_TO_FILES=false ya van por defecto.)
