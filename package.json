{
  "name": "booking-prototipo-plantilla",
  "version": "1.0.0",
  "description": "Plantilla base para el sistema de Booking Prototipo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "contract:export": "node scripts/export-openapi.js",
    "seed:vuelos": "ts-node src/modules/vuelos/seed/seed.ts",
    "seed:vuelos:prod": "node dist/modules/vuelos/seed/seed.js",
    "migration:generate:vuelos": "typeorm-ts-node-commonjs migration:generate -d src/modules/vuelos/migrations/data-source.ts",
    "migration:run:vuelos": "typeorm-ts-node-commonjs migration:run -d src/modules/vuelos/migrations/data-source.ts",
    "migration:revert:vuelos": "typeorm-ts-node-commonjs migration:revert -d src/modules/vuelos/migrations/data-source.ts",
    "migration:check:vuelos": "typeorm-ts-node-commonjs migration:generate -d src/modules/vuelos/migrations/data-source.ts --check src/modules/vuelos/migrations/Check",
    "migration:run:vuelos:prod": "typeorm migration:run -d dist/modules/vuelos/migrations/data-source.js",
    "start:render": "npm run migration:run:vuelos:prod && npm run seed:vuelos:prod && npm run start:prod",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.4",
    "jest": "^30.5.2",
    "js-yaml": "^4.1.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}
