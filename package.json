{
  "name": "ram-alliance-vuelos",
  "version": "1.0.0",
  "description": "RAM Alliance: sistema de venta de vuelos (NestJS, TypeORM, PostgreSQL, React)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "contract:export": "node scripts/export-openapi.js",
    "seed:vuelos": "ts-node src/modules/vuelos/seed/seed.ts",
    "seed:vuelos:prod": "node dist/modules/vuelos/seed/seed.js",
    "migration:generate:vuelos": "typeorm-ts-node-commonjs migration:generate -d src/modules/vuelos/migrations/data-source.ts",
    "migration:run:vuelos": "typeorm-ts-node-commonjs migration:run -d src/modules/vuelos/migrations/data-source.ts",
    "migration:revert:vuelos": "typeorm-ts-node-commonjs migration:revert -d src/modules/vuelos/migrations/data-source.ts",
    "migration:check:vuelos": "typeorm-ts-node-commonjs migration:generate -d src/modules/vuelos/migrations/data-source.ts --check src/modules/vuelos/migrations/Check",
    "migration:run:vuelos:prod": "typeorm migration:run -d dist/modules/vuelos/migrations/data-source.js",
    "start:render": "npm run migration:run:vuelos:prod && npm run seed:vuelos:prod && npm run start:prod",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "docs:modelo": "ts-node scripts/export-modelo-datos.ts",
    "contract:events:check": "ts-node scripts/check-schema-compat.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.16.2",
    "jsonwebtoken": "^9.0.3",
    "opossum": "^10.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "js-yaml": "^4.1.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.1"
  }
}
