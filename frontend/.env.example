# URL base de la API (en producción: https://proyect-flights-rda1-plantilla.onrender.com/api/v1)
VITE_API_URL=https://proyect-flights-rda1-plantilla.onrender.com/api/v1
# Destino del proxy de desarrollo (si se usa proxy local)
VITE_BACKEND_TARGET=https://proyect-flights-rda1-plantilla.onrender.com
# Habilitar selector de tarjetas de prueba para simulación
VITE_SHOW_TEST_CARDS=true
# URL del gateway GraphQL (auditoría). Si se omite se deriva de VITE_API_URL: https://host/api/v1 -> https://host/graphql
# VITE_GRAPHQL_URL=https://proyect-flights-rda1-plantilla.onrender.com/graphql
